# Copy to .env and fill in. Never commit real credentials.

# Target environment (PS-9250 smoke target)
BASE_URL=https://www.test.plansight.com

# Broker test user (required for authenticated flows S1.2+, S2, S3, S4, S5, S6, S7, S9)
BROKER_EMAIL=
BROKER_PASSWORD=

# Carrier test user (optional; required only for S8 carrier path)
CARRIER_EMAIL=
CARRIER_PASSWORD=

# Existing employer group name to open (S2.2). If unset, S2.2 opens the first group in the list.
EXISTING_GROUP_NAME=

# Optional: an existing employer group to start the RFP wizard from (S3). Falls back to first group.
RFP_GROUP_NAME=

# Prefix used when the suite creates a test RFP so carriers are not spammed (S3).
# The created RFP name will be `${TEST_RFP_PREFIX} <timestamp>`.
TEST_RFP_PREFIX=ZZ-SMOKE-DO-NOT-SEND

# Absolute or relative path to the SBC upload fixture used in S3.13 / Minimum Gate.
# Defaults to tests/fixtures/sbc-sample.pdf (a placeholder is generated if missing).
SBC_PDF_PATH=

# Set to "1" to allow the suite to actually send/publish an RFP to carriers in S3.7.
# Default (unset/0) keeps the suite non-destructive: it saves without full publish.
ALLOW_RFP_SEND=0
