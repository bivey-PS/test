{
  "name": "ps9250-playwright-smoke",
  "version": "1.0.0",
  "private": true,
  "description": "PS-9250 smoke test automation for www.test.plansight.com (Playwright)",
  "scripts": {
    "test": "playwright test",
    "test:min-gate": "playwright test --grep @min-gate",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "list": "playwright test --list",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://www.test.plansight.com",
    "typecheck": "tsc --noEmit",
    "install:browsers": "playwright install --with-deps chromium"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.5.0",
    "dotenv": "^16.4.5",
    "typescript": "^5.5.4"
  }
}
