# PS-9250 Minimum Gate automation — copy to .env and fill in values
#   cp scripts/ps-9250/.env.example scripts/ps-9250/.env
#
# Shell environment variables override .env values.
# Do not commit .env (it is gitignored).

# Target Plansight environment
BASE_URL=https://test.plansight.com

# Login credentials (defaults in config.js use the PS automation broker user)
LOGIN_USERNAME=your@email.com
LOGIN_PASSWORD=yourpassword

# SMS code — set at run time only when session expires; do not store a real code here
# MFA_CODE=123456

# Employer group opened in S2.2 and used through the RFP flow
EMPLOYER_NAME=Ace Testing

# Jira ticket label for reports
JIRA_TICKET=PS-9250

# Runner options (used by minimum-gate.js)
# HEADED=1
# RECORD_VIDEO=1
# PAUSE_MS=1500
